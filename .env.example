# ============================================================
# Environment template — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real credentials.
# ============================================================

# Hugging Face (for dataset download and model loading)
HF_TOKEN=

# Cohere (Phase 4 heuristic generation)
COHERE_API_KEY=

# CloudRift — OpenAI-compatible inference endpoint (NOT OpenAI.com)
# Use this base URL explicitly in code; do not rely on OPENAI_API_KEY
# defaulting to api.openai.com when CloudRift is intended.
CLOUDRIFT_API_KEY=
CLOUDRIFT_BASE_URL=

# Mistral (Phase 4 heuristic generation)
MISTRAL_API_KEY=

# Cerebras
CEREBRAS_API_KEY=

# Fireworks
FIREWORKS_API_KEY=

# Anthropic / Claude (audit / review tasks)
ANTHROPIC_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Groq
GROQ_API_KEY=

# xAI / Grok
XAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# Experiment paths (override defaults if needed)
# ============================================================
LLMSERVEOPT_RESULTS_DIR=results
LLMSERVEOPT_DATA_DIR=data
