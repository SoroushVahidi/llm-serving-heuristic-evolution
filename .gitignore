# Python / build cache
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.so

# Virtual environments
.venv/
venv/
env/

# Secrets — NEVER commit these
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.json.secret
secrets.*
credentials.json

# Data and results (large files; commit selectively)
data/raw/*
!data/raw/**/.gitkeep
data/processed/*
!data/processed/**/.gitkeep
results/*
!results/.gitkeep
traces/

# Large binary / model artifacts
*.bin
*.safetensors
*.pt
*.ckpt
*.parquet
*.cache

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.ipynb

# Coverage
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
