# Python / build cache
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.so

# Virtual environments
.venv/
venv/
env/

# Secrets — NEVER commit these
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.json.secret
secrets.*
credentials.json

# Data and results (large files; commit selectively)
data/raw/*
!data/raw/**/.gitkeep
data/processed/*
!data/processed/**/.gitkeep
results/*
!results/.gitkeep
traces/

# Experiment logs (runtime output; not source code)
logs/

# Raw GPU/server runtime logs under experiments/ -- these are verbose,
# regeneratable raw stdout, not the canonical result. The small structured
# artifacts alongside them (summary.md, summary.json, scenario_results.json,
# manifest.json, etc.) are committed normally; only the raw server.log is
# excluded here.
#
# Pre-existing exception (already tracked before this pattern was added;
# new gitignore patterns do not untrack already-committed files, and these
# are intentionally kept -- do not `git rm --cached` them):
#   experiments/real_llm/vllm_healthcheck_20260703T171021Z/server.log
#   experiments/real_llm/vllm_baseline_comparison_pilot_20260703T165438Z/server.log
experiments/**/server.log

# Selector v2 calibrated-pilot large raw CSVs -- regeneratable from
# scripts/build_selector_dataset_v2_calibrated_targeted_pilot.py, local-only
# by design (see docs/current/PROJECT_STATUS.md and
# docs/current/WULVER_HANDOFF.md). The pilot's small provenance/summary/
# manifest/audit files alongside them are committed normally.
experiments/selector_v2_calibrated_pilot_*/full_policy_vectors.csv
experiments/selector_v2_calibrated_pilot_*/window_features.csv

# Large binary / model artifacts
*.bin
*.safetensors
*.pt
*.ckpt
*.parquet
*.cache

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.ipynb

# Coverage
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Claude Code project memory (local only)
.claude/
